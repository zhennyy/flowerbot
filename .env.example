# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# Адрес витрины: локально — от ngrok, на сервере — https://fleur.botforall.ru
WEBAPP_URL=https://xxxx.ngrok-free.app
# Твой Telegram ID (команда /myid в боте) — для админки и уведомлений
OWNER_ID=123456789
PORT=3000

# Онлайн-оплата ЮKassa (если не заполнить — заказы принимаются без онлайн-оплаты)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# На сервере: папка для базы и фото (обновления её не трогают)
# DATA_DIR=/data/flowerbot
# Сервер слушает только localhost (наружу — через nginx); 0.0.0.0 — если нужен прямой доступ
# HOST=127.0.0.1
